{
  "name": "github-sync-api",
  "type": "service",
  "version": "0.1.0",
  "language": "Ballerina",
  "buildpack": "docker",
  "appPath": "github-sync-api",
  "entrypoint": "deployment/service",
  "exposure": "internet",
  "stories": [
    2,
    3,
    4,
    5,
    6,
    7,
    8,
    9
  ],
  "description": "Backend for the GitHub-to-Google-Chat critical issue sync. Owns the watched-repository list, the Google Chat destination, the Administrator's GitHub OAuth connection, and the periodic poll that detects new critical issues and posts a notification exactly once per issue. Exposes the API the admin web app calls; does not render any UI and never writes back to GitHub.",
  "dependencies": [
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "sync-github-issue-24469684",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "sync-db",
      "resourceType": "postgres-cnpg",
      "wiring": {
        "ref": "sync-github-issues-sync-db",
        "envBindings": {
          "dbname": "SYNC_DB_DBNAME",
          "host": "SYNC_DB_HOST",
          "password": "SYNC_DB_PASSWORD",
          "port": "SYNC_DB_PORT",
          "user": "SYNC_DB_USER"
        }
      }
    },
    {
      "kind": "external",
      "name": "github",
      "description": "Exchanges the Administrator's OAuth code for an access token, lists their repositories, and polls each watched repository's open issues labeled critical.",
      "wiring": {
        "ref": "sync-github-issues-github",
        "envBindings": {
          "GITHUB_CLIENT_ID": "GITHUB_CLIENT_ID",
          "GITHUB_CLIENT_SECRET": "GITHUB_CLIENT_SECRET",
          "GITHUB_OAUTH_REDIRECT_URI": "GITHUB_OAUTH_REDIRECT_URI"
        }
      }
    },
    {
      "kind": "external",
      "name": "google-chat",
      "description": "Posts a notification message when a new critical issue is found on a watched repository.",
      "wiring": {
        "ref": "sync-github-issue-5eac2ae4",
        "envBindings": {
          "GOOGLE_CHAT_WEBHOOK_URL": "GOOGLE_CHAT_WEBHOOK_URL"
        }
      }
    }
  ],
  "exposesAPI": {
    "auth": "end-user-required"
  },
  "skillsPinned": [
    "openapi-conventions",
    "ballerina",
    "api-management",
    "thunder-authentication"
  ]
}
